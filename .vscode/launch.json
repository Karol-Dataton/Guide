{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (Windows)",
            "url": "C:\\src\\WO_keys\\wiki\\index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Wiki (Mac)",
            "file": "${workspaceFolder}/wiki/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Controller (NPM Start)",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "start"
            ],
            "cwd": "${workspaceFolder}/controller"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Dashboard (Server)",
            "program": "${workspaceFolder}/dashboard/proxy-server.js",
            "cwd": "${workspaceFolder}/dashboard"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Build Wiki",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "build"
            ],
            "cwd": "${workspaceFolder}/wiki"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Build WP64 Wiki",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "build"
            ],
            "cwd": "${workspaceFolder}/hardware/WP64"
        }
    ]
}